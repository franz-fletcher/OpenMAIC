  "slices": [
    {
      "id": "S01",
      "title": "Coerce stringified widgetOutline in generate_scene",
      "intent": "Coerce a stringified widgetOutline before the existing object guard in generate_scene. generate_scene.execute parses a string widgetOutline with JSON.parse before the guard. A parsed plain non-null non-array object replaces the param and proceeds. Any other outcome keeps the rejection path with error code invalid-widget-outline and a message that requires a plain JSON object, not a stringified one. No other param is coerced.",
      "user_stories": [
        1
      ],
      "blocked_by": [],
      "targets": [
        {
          "path": "lib/server/agent-runtime/generation-tools.ts",
          "symbols": [
            {
              "name": "generateScene",
              "kind": "variable",
              "expectation": "A JSON-encoded object string lands in SceneOutline.widgetOutline as the parsed object, and the interactive page persists with that outline. The existing passing-through test (widgetOutline: { concept: 'Water cycle', diagramType: 'mindmap' }) stays green. The existing null and 'mindmap' rejection tests stay green on the error code, and assert the new message text.",
              "before": {
                "exists": false
              },
              "postcondition": {
                "exists": false
              },
              "postcondition_quality": "INSPECTED"
            },
            {
              "name": "buildGenerationTools",
              "before": {
                "exists": true,
                "kind": "function",
                "signature": "(deps: GenerationToolDeps): AgentTool<never, never>[]"
              },
              "postcondition": {
                "exists": true,
                "kind": "function",
                "signature": "(deps: GenerationToolDeps): AgentTool<never, never>[]"
              },
              "postcondition_quality": "INSPECTED",
              "expectation": "A JSON-encoded object string lands in SceneOutline.widgetOutline as the parsed object. Existing tests stay green: the plain-object pass-through, and the null and 'mindmap' rejections on error code invalid-widget-outline with the new message."
            }
          ]
        }
      ],
      "riskTier": 2,
      "uuid": "dece5a74-b3fe-464c-b83c-9963bc757a7b",
      "impl": {
