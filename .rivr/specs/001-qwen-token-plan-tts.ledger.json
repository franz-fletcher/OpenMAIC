      },
      "expectation": "generateTTS dispatches qwen-token-plan-tts to the new client. The client opens a pooled socket with Authorization header init, sends run-task then continue-task with the full text then finish-task, concatenates binary mp3 frames, and maps task-failed, abort, and timeout to an error class extending QwenTTSError. The pool defaults to 2 connections, 60s idle reaper, reuse after task-finished with fresh task_id, discard after task-failed, env override OPENMAIC_QWEN_TOKEN_PLAN_WS_POOL_SIZE, shutdown drain anchored in instrumentation. Hermetic vitest with stubbed WebSocket passes.",
      "gates": [
        {
          "id": "G2.1",
          "check": "npx vitest run tests/audio/qwen-token-plan-tts.test.ts",
          "expect": "exit code 0",
          "evidence": "pending",
          "type": "unit"
        }
